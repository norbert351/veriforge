{
  "name": "veriforge",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w packages/contracts && npm run build -w apps/api && npm run build -w apps/web",
    "compile": "npm run compile -w packages/contracts",
    "test:contracts": "npm run test -w packages/contracts",
    "deploy:bot": "npm run deploy:bot -w packages/contracts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.0",
    "next": "15.5.22",
    "pdf-parse": "^2.4.5"
  }
}
